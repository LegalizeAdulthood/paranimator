{
  "parameter_catalogs": [
    "viewport-catalog.json"
  ],
  "source": {
    "file": "from.par",
    "name": "@TEST_SOURCE_PAR@"
  },
  "output": {
    "directory": "@TEST_OUTPUT_DIRECTORY@",
    "par": "@TEST_OUTPUT_PAR@",
    "entry": "@TEST_OUTPUT_ENTRY@",
    "script": "@TEST_OUTPUT_SCRIPT@"
  },
  "video": "@TEST_VIDEO_MODE@",
  "num_frames": 60,
  "tracks": [
    {
      "parameter": "@TEST_TRACK_PARAMETER@",
      "keys": [
        { "frame": 0, "value": "@TEST_TRACK_FROM@" },
        { "frame": 59, "value": "@TEST_TRACK_TO@" }
      ]
    }
  ]
}
