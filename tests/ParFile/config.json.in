{
  "from": {
    "file": "from.par",
    "name": "@TEST_FROM_PAR@"
  },
  "to": {
    "file": "to.par",
    "name": "@TEST_TO_PAR@"
  },
  "interpolate": [ "@TEST_INTERPOLATE@" ],
  "output": {
    "directory": "@TEST_OUTPUT_DIRECTORY@",
