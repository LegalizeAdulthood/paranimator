{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalize.github.io/paranimator/schemas/config.schema.json",
  "title": "ParAnimator configuration",
  "type": "object",
  "required": [ "parameter_catalogs", "source", "output", "video", "num_frames", "tracks" ],
  "additionalProperties": false,
  "properties": {
    "parameter_catalogs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "type": "string" }
    },
    "source": {
      "type": "object",
      "required": [ "file", "name" ],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "output": {
      "type": "object",
      "required": [ "directory", "par", "entry", "script" ],
      "additionalProperties": false,
      "properties": {
        "directory": { "type": "string" },
        "par": { "type": "string" },
        "entry": { "type": "string" },
        "script": { "type": "string" }
      }
    },
    "parallel": { "type": "integer" },
    "video": { "type": "string" },
    "num_frames": { "type": "integer" },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [ "parameter", "keys" ],
        "additionalProperties": false,
        "properties": {
          "parameter": { "type": "string" },
          "keys": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": [ "frame", "value" ],
              "additionalProperties": false,
              "properties": {
                "frame": { "type": "integer" },
                "value": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
