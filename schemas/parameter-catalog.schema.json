{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalize.github.io/paranimator/schemas/parameter-catalog.schema.json",
  "title": "ParAnimator parameter catalog",
  "type": "object",
  "required": [ "parameters" ],
  "additionalProperties": false,
  "properties": {
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [ "type" ],
        "additionalProperties": false,
        "properties": {
          "type": { "$ref": "#/$defs/parameter_type" },
          "format": { "$ref": "#/$defs/parameter_format" },
          "default_curve": { "$ref": "#/$defs/curve" },
          "extrapolate": { "$ref": "#/$defs/extrapolate" }
        }
      }
    }
  },
  "$defs": {
    "parameter_type": {
      "type": "string",
      "enum": [ "center_mag", "corners", "integer" ]
    },
    "parameter_format": {
      "type": "string",
      "enum": [ "raw", "slash" ]
    },
    "curve": {
      "type": "string",
      "enum": [ "geometric", "hold", "linear", "step" ]
    },
    "extrapolate": {
      "type": "string",
      "enum": [ "clamp" ]
    }
  }
}
