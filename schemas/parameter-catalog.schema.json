{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalize.github.io/paranimator/schemas/parameter-catalog.schema.json",
  "title": "ParAnimator parameter catalog",
  "type": "object",
  "required": [ "parameters" ],
  "additionalProperties": false,
  "properties": {
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/parameter-metadata"
      }
    },
    "fractal-types": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "format": { "$ref": "#/$defs/parameter-format" },
              "slots": {
                "type": "array",
                "items": { "$ref": "#/$defs/params-slot-metadata" }
              },
              "groups": {
                "type": "object",
                "additionalProperties": { "$ref": "#/$defs/params-group-metadata" }
              }
            }
          }
        }
      }
    },
    "formula-entries": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/formula-entry-metadata" }
    }
  },
  "$defs": {
    "parameter-metadata": {
      "type": "object",
      "required": [ "type" ],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/parameter-type" },
        "format": { "$ref": "#/$defs/parameter-format" },
        "default-curve": { "$ref": "#/$defs/curve" },
        "extrapolate": { "$ref": "#/$defs/extrapolate" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "params-slot-metadata": {
      "type": "object",
      "required": [ "index", "name", "type" ],
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "type": { "$ref": "#/$defs/parameter-type" },
        "format": { "$ref": "#/$defs/parameter-format" },
        "default-curve": { "$ref": "#/$defs/curve" },
        "extrapolate": { "$ref": "#/$defs/extrapolate" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "params-group-metadata": {
      "type": "object",
      "required": [ "type", "slots" ],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/parameter-type" },
        "format": { "$ref": "#/$defs/parameter-format" },
        "default-curve": { "$ref": "#/$defs/curve" },
        "extrapolate": { "$ref": "#/$defs/extrapolate" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "formula-entry-metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "knobs": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/formula-params-knob-metadata" }
            }
          }
        }
      }
    },
    "formula-params-knob-metadata": {
      "type": "object",
      "required": [ "type", "variable" ],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/formula-knob-type" },
        "variable": { "type": "string" },
        "format": { "$ref": "#/$defs/parameter-format" },
        "default-curve": { "$ref": "#/$defs/curve" },
        "extrapolate": { "$ref": "#/$defs/extrapolate" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "complex" } } },
          "then": { "properties": { "variable": { "pattern": "^p[1-4]$" } } }
        },
        {
          "if": { "properties": { "type": { "enum": [ "integer", "real" ] } } },
          "then": { "properties": { "variable": { "pattern": "^p[1-4]\\.(real|imag)$" } } }
        }
      ]
    },
    "formula-knob-type": {
      "type": "string",
      "enum": [ "complex", "integer", "real" ]
    },
    "parameter-type": {
      "type": "string",
      "enum": [ "center-mag", "complex", "corners", "double", "integer" ]
    },
    "parameter-format": {
      "type": "string",
      "enum": [ "raw", "slash", "slash-list", "slash-pair" ]
    },
    "curve": {
      "type": "string",
      "enum": [ "geometric", "hold", "linear", "step" ]
    },
    "extrapolate": {
      "type": "string",
      "enum": [ "base", "clamp", "cycle", "omit", "ping-pong" ]
    }
  }
}
