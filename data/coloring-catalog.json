{
  "parameters": {
    "colors": {
      "type": "color-map",
      "format": "raw",
      "default-curve": "hold",
      "extrapolate": "clamp"
    },
    "decomp": {
      "type": "string",
      "format": "slash",
      "default-curve": "hold",
      "extrapolate": "clamp"
    },
    "distest": {
      "type": "integer-tuple",
      "format": "slash",
      "default-curve": "hold",
      "extrapolate": "clamp",
      "arity": 2
    },
    "logmap": {
      "type": "integer-or-enum",
      "format": "raw",
      "values": [ "no", "old", "yes" ],
      "default-curve": "hold",
      "extrapolate": "clamp"
    },
    "logmode": {
      "type": "enum",
      "format": "raw",
      "values": [ "fly", "table", "auto" ],
      "default-curve": "hold",
      "extrapolate": "clamp"
    },
    "map": {
      "type": "string",
      "format": "raw",
      "default-curve": "hold",
      "extrapolate": "clamp"
    },
    "nobof": {
      "type": "yes-no",
      "format": "raw",
      "default-curve": "hold",
      "extrapolate": "clamp"
    },
    "olddemmcolors": {
      "type": "yes-no",
      "format": "raw",
      "default-curve": "hold",
      "extrapolate": "clamp"
    },
    "ranges": {
      "type": "string",
      "format": "slash-list",
      "default-curve": "hold",
      "extrapolate": "clamp"
    },
    "truecolor": {
      "type": "yes-no",
      "format": "raw",
      "default-curve": "hold",
      "extrapolate": "clamp"
    },
    "truemode": {
      "type": "string",
      "format": "raw",
      "default-curve": "hold",
      "extrapolate": "clamp"
    }
  }
}
